{
  "$comment": "Source of truth for the Sangam Civic case state machine. The SQL migration seeds civic.case_transitions from this file's values (checked by contracts/test), and the web app's domain/civic.ts is tested against it. Blueprint rule: no transition outside this machine; every transition logged with its actor.",
  "name": "civic_case",
  "initial": "DRAFT",
  "states": [
    "DRAFT",
    "SUBMITTED",
    "TRIAGED",
    "ROUTING_PENDING",
    "ROUTED",
    "ACKNOWLEDGED",
    "IN_PROGRESS",
    "RESPONSE_RECEIVED",
    "RESOLUTION_REVIEW",
    "RESOLVED",
    "UNRESOLVED",
    "CLOSED",
    "WITHDRAWN",
    "REJECTED",
    "DUPLICATE",
    "REOPENED"
  ],
  "terminal": ["CLOSED", "WITHDRAWN", "REJECTED", "DUPLICATE"],
  "actors": {
    "complainant": "The person who filed the case. Only actor allowed to confirm a resolution.",
    "platform": "Sangam Civic staff or automation (triage, routing).",
    "authority": "A public office. Its steps need a verified official source reference."
  },
  "transitions": [
    { "from": "DRAFT", "to": "SUBMITTED", "action": "submit", "actor": "complainant" },
    { "from": "SUBMITTED", "to": "TRIAGED", "action": "triage", "actor": "platform" },
    { "from": "SUBMITTED", "to": "REJECTED", "action": "reject", "actor": "platform" },
    { "from": "SUBMITTED", "to": "DUPLICATE", "action": "mark_duplicate", "actor": "platform" },
    { "from": "TRIAGED", "to": "ROUTING_PENDING", "action": "start_routing", "actor": "platform" },
    { "from": "TRIAGED", "to": "REJECTED", "action": "reject", "actor": "platform" },
    { "from": "TRIAGED", "to": "DUPLICATE", "action": "mark_duplicate", "actor": "platform" },
    { "from": "ROUTING_PENDING", "to": "ROUTED", "action": "route", "actor": "platform" },
    { "from": "ROUTED", "to": "ACKNOWLEDGED", "action": "acknowledge", "actor": "authority", "requires": "verified_source" },
    { "from": "ACKNOWLEDGED", "to": "IN_PROGRESS", "action": "report_progress", "actor": "authority", "requires": "verified_source" },
    { "from": "IN_PROGRESS", "to": "RESPONSE_RECEIVED", "action": "respond", "actor": "authority", "requires": "verified_source" },
    { "from": "RESPONSE_RECEIVED", "to": "RESOLUTION_REVIEW", "action": "request_confirmation", "actor": "platform" },
    { "from": "RESOLUTION_REVIEW", "to": "RESOLVED", "action": "confirm_fixed", "actor": "complainant" },
    { "from": "RESOLUTION_REVIEW", "to": "UNRESOLVED", "action": "confirm_not_fixed", "actor": "complainant" },
    { "from": "RESOLVED", "to": "CLOSED", "action": "close", "actor": "platform" },
    { "from": "UNRESOLVED", "to": "IN_PROGRESS", "action": "escalate", "actor": "complainant" },
    { "from": "RESOLVED", "to": "REOPENED", "action": "reopen", "actor": "complainant" },
    { "from": "UNRESOLVED", "to": "REOPENED", "action": "reopen", "actor": "complainant" },
    { "from": "CLOSED", "to": "REOPENED", "action": "reopen", "actor": "complainant" },
    { "from": "REOPENED", "to": "TRIAGED", "action": "triage", "actor": "platform" },
    { "from": "SUBMITTED", "to": "WITHDRAWN", "action": "withdraw", "actor": "complainant" },
    { "from": "TRIAGED", "to": "WITHDRAWN", "action": "withdraw", "actor": "complainant" },
    { "from": "ROUTING_PENDING", "to": "WITHDRAWN", "action": "withdraw", "actor": "complainant" },
    { "from": "ROUTED", "to": "WITHDRAWN", "action": "withdraw", "actor": "complainant" },
    { "from": "ACKNOWLEDGED", "to": "WITHDRAWN", "action": "withdraw", "actor": "complainant" },
    { "from": "IN_PROGRESS", "to": "WITHDRAWN", "action": "withdraw", "actor": "complainant" },
    { "from": "RESPONSE_RECEIVED", "to": "WITHDRAWN", "action": "withdraw", "actor": "complainant" },
    { "from": "RESOLUTION_REVIEW", "to": "WITHDRAWN", "action": "withdraw", "actor": "complainant" },
    { "from": "REOPENED", "to": "WITHDRAWN", "action": "withdraw", "actor": "complainant" }
  ],
  "events_without_state_change": [
    { "action": "escalate", "actor": "complainant", "allowed_in": ["ROUTED", "ACKNOWLEDGED", "IN_PROGRESS", "RESPONSE_RECEIVED"], "note": "Sets the escalated flag; the case keeps its state." },
    { "action": "add_evidence", "actor": "complainant", "allowed_in": ["DRAFT", "SUBMITTED", "TRIAGED", "ROUTING_PENDING", "ROUTED", "ACKNOWLEDGED", "IN_PROGRESS", "REOPENED"] },
    { "action": "add_note", "actor": "platform", "allowed_in": ["SUBMITTED", "TRIAGED", "ROUTING_PENDING", "ROUTED", "ACKNOWLEDGED", "IN_PROGRESS", "RESPONSE_RECEIVED", "RESOLUTION_REVIEW", "REOPENED"] }
  ]
}
