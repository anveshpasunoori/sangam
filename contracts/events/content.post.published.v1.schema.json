{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sangam.example/events/content.post.published.v1.schema.json",
  "title": "content.post.published.v1",
  "description": "A post passed screening and was published. Feed fan-out consumes this; it must still re-check visibility at serve time.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "content.post.published.v1"
    },
    "aggregate": {
      "properties": {
        "type": {
          "const": "post"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "post_id",
        "author_id",
        "audience",
        "published_at",
        "has_media"
      ],
      "additionalProperties": false,
      "properties": {
        "post_id": {
          "type": "string",
          "format": "uuid"
        },
        "author_id": {
          "type": "string",
          "format": "uuid"
        },
        "audience": {
          "enum": [
            "public",
            "friends",
            "close_friends",
            "only_me"
          ]
        },
        "community_id": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "lang": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "has_media": {
          "type": "boolean"
        }
      }
    }
  },
  "examples": [
    {
      "id": "e0e0e0e0-0000-4000-8000-000000000003",
      "type": "content.post.published.v1",
      "occurred_at": "2026-11-20T09:15:00Z",
      "aggregate": {
        "type": "post",
        "id": "see-data"
      },
      "data": {
        "post_id": "0b9a3c2e-5f1d-4e2a-8f00-000000000101",
        "author_id": "6f2b6a0e-1d0c-4c3a-9a51-2b1f1f1f0001",
        "audience": "friends",
        "community_id": null,
        "lang": "hi",
        "published_at": "2026-11-20T09:15:00Z",
        "has_media": true
      }
    }
  ]
}